# For local and phone/LAN testing, use '/api'.
# Vite's dev server on 0.0.0.0 will proxy '/api' requests to VITE_API_PROXY_TARGET.
# This ensures testing on phones/tablets works seamlessly without hardcoding a local IP.
VITE_API_URL=/api

# Local dev proxy target (backend server)
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
