PORT=5000
# Database connection options:
# Option A: Discrete parameters
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ethio_exam_hall
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20

# Option B: Single connection string (standard for PaaS e.g. Render, Railway, Neon, Supabase)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/ethio_exam_hall

# CORS (wildcard or comma-separated list of origins)
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=ethio_exam_hall_jwt_super_secret_dev_key_2026
JWT_EXPIRES_IN=7d

# File Storage
STORAGE_DIR=./storage

# Telegram OpenID Connect Authentication (from @BotFather Login Widget)
TELEGRAM_LOGIN_ENABLED=true
TELEGRAM_ALLOW_REGISTRATION=true
TELEGRAM_CLIENT_ID=your_telegram_bot_client_id_from_botfather
TELEGRAM_CLIENT_SECRET=your_telegram_bot_client_secret_from_botfather
TELEGRAM_BOT_USERNAME=EthioExamHallBot
TELEGRAM_ISSUER=https://oauth.telegram.org
TELEGRAM_REDIRECT_URI=http://localhost:5000/api/auth/telegram/callback
TELEGRAM_ORIGIN=http://localhost:5000

# Application Frontend & Backend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
