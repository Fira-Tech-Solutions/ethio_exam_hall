# -------------------------------------------------------------
# Ethio Exam Hall — Backend Service Environment Variables
# -------------------------------------------------------------

# Port (used for local development; Vercel automatically sets port/serverless handler)
PORT=5000

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# Option A: Single Connection String (Recommended for Vercel, Neon, Supabase, Railway)
# Example: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/ethio_exam_hall?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/ethio_exam_hall

# Option B: Discrete Parameters (Local Dev)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ethio_exam_hall
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=10

# -------------------------------------------------------------
# CORS & Security
# -------------------------------------------------------------
# For Vercel production: set to '*' or your comma-separated frontend domains:
# Example: https://ethio-exam.vercel.app,https://ethio-exam-admin.vercel.app
CORS_ORIGIN=*

# JWT Secret & Expiry
JWT_SECRET=ethio_exam_hall_jwt_super_secret_production_key_2026
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# Application URLs (for OAuth & Redirects)
# -------------------------------------------------------------
# Public URL of your deployed student frontend:
FRONTEND_URL=https://your-main-website.vercel.app

# Public URL of this deployed backend service:
BACKEND_URL=https://your-backend-service.vercel.app

# -------------------------------------------------------------
# Telegram OpenID Connect (BotFather)
# -------------------------------------------------------------
TELEGRAM_LOGIN_ENABLED=true
TELEGRAM_ALLOW_REGISTRATION=true
TELEGRAM_CLIENT_ID=your_telegram_bot_client_id
TELEGRAM_CLIENT_SECRET=your_telegram_bot_client_secret
TELEGRAM_BOT_USERNAME=ET_EXAM_HALL_bot
TELEGRAM_ISSUER=https://oauth.telegram.org
TELEGRAM_REDIRECT_URI=https://your-backend-service.vercel.app/api/auth/telegram/callback
TELEGRAM_ORIGIN=https://your-backend-service.vercel.app
